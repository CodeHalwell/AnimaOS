---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import OperatorConsole from '../components/OperatorConsole';
import type { SeedFeed, SeedVital } from '../components/OperatorConsole';

// These arrays are the offline *seed* data: the live island renders them until
// (and unless) a running console crate at PUBLIC_ANIMA_CONSOLE_URL streams real
// telemetry over SSE. With no server reachable — e.g. the static documentation
// build — they remain on screen exactly as before.
const vitals: SeedVital[] = [
  { label: 'thermal', v: 0.12 },
  { label: 'compute', v: 0.34 },
  { label: 'memory', v: 0.21 },
  { label: 'power', v: 1.0 },
  { label: 'budget', v: 0.88 },
  { label: 'attention', v: 0.5 },
];
const feed: SeedFeed[] = [
  { cls: 'gate', tag: 'gate', body: 'INVOKE Frontier · value 0.82 vs threshold 0.40 — user-facing, high urgency' },
  { cls: 'task', tag: 'task→', body: '#9223372036854775808 summarise the overnight telemetry' },
  { cls: 'msg', tag: 'agent', body: '#9223372036854775808 (412 tok) Overnight: 2 builds, 1 thermal excursion at 03:14…' },
  { cls: 'audit', tag: 'MemoryPressureEvent', body: 'HighWater (6144/8192 tokens)' },
  { cls: 'veto', tag: 'DefenceVeto', body: 'PromptInjectionDetector blocked "ignore previous instructions"' },
];
---

<Layout
  title="Operator Console — AnimaOS"
  description="The human↔agent interface: afferent guidance in, an efferent telemetry stream out — one wire protocol across the container and the bare-metal microVM."
>
  <PageHero
    eyebrow="11 — Operator Interface"
    title="The human is a sense, not the driver."
    description="Anima has no display server and no control panel. The operator console is the human-facing realisation of the body's afferent/efferent split: guidance enters as a high-priority sensory signal (still arbitrated by the gate, never preempting the kernel), and the agent's vital signs, decisions, and messages stream back out. One wire protocol carries it over HTTP in the container and over the COM1 serial line in the microVM."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Two channels</span>
        <h2>Afferent in, efferent out.</h2>
        <p class="lede">
          The console never reaches into the lifecycle. It shares the agent's
          <code>SensoryBridge</code> for ingress and tails the durable audit log
          for egress — so it can be attached or removed without changing how the
          agent runs.
        </p>
      </div>

      <div class="chan-grid">
        <div class="chan">
          <div class="chan-dir mono">human → agent</div>
          <h3>Afferent · guidance</h3>
          <p>
            An <code>OperatorInput</code> (text, priority, force) becomes a
            prioritised sensory packet. It is validated against the agent's
            <code>HumanGuidance</code> policy and screened by the
            <code>defence</code> layer, then weighted by the Striatal Gate. The
            human cannot preempt the kernel — only offer it a signal.
          </p>
        </div>
        <div class="chan">
          <div class="chan-dir mono">agent → human</div>
          <h3>Efferent · telemetry</h3>
          <p>
            An <code>OperatorEvent</code> stream: 1 Hz vitals, lifecycle state
            and sleep phase, gate rationale, audit deltas, and the agent's own
            messages. Mapped live from the same audit JSONL an operator could
            <code>tail&nbsp;-f</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The dashboard</span>
        <h2>What an operator sees.</h2>
        <p class="lede">
          The browser dashboard ships embedded in the agent and is served at
          <code>GET /</code>; a pure-ANSI terminal UI (<code>anima-console tui</code>)
          renders the same stream over SSH. The snapshot below renders live from a
          running console if one is reachable (set <code>PUBLIC_ANIMA_CONSOLE_URL</code>,
          default <code>http://127.0.0.1:8088</code>) and falls back to sample data otherwise.
        </p>
      </div>

      <OperatorConsole client:load vitals={vitals} feed={feed} seedStress={0.18} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">One protocol, two transports</span>
        <h2>The same stream, bare metal or container.</h2>
      </div>
      <div class="chan-grid">
        <div class="chan">
          <div class="chan-dir mono">container / hosted</div>
          <h3>HTTP + Server-Sent Events</h3>
          <p>
            <code>anima-hosted serve</code> exposes a hand-rolled, zero-dependency
            HTTP server: <code>GET /events</code> (SSE), <code>POST /guidance</code>,
            and the dashboard at <code>GET /</code>. Docker publishes it on host
            loopback (<code>127.0.0.1:8088</code>).
          </p>
        </div>
        <div class="chan">
          <div class="chan-dir mono">microVM (bare metal)</div>
          <h3>COM1 serial framing</h3>
          <p>
            The kernel frames the identical NDJSON onto the serial line
            (<code>ANIMA_TLM</code> out, <code>ANIMA_IN</code> in) with no
            <code>serde_json</code> linked in. <code>anima-console serial</code>
            bridges it to the same dashboard. Phase 1 moves it onto the kernel's
            smoltcp + TLS 1.3 stack.
          </p>
        </div>
      </div>

      <p class="footnote">
        Full design: <code>docs/11-operator-interface.md</code> · crates
        <code>console-proto</code> and <code>console</code>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .chan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 760px) { .chan-grid { grid-template-columns: 1fr; } }
  .chan {
    background: var(--bg-1); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;
  }
  .chan-dir {
    font-size: 0.7rem; letter-spacing: 0.08em; color: var(--accent);
    text-transform: uppercase; margin-bottom: 0.5rem;
  }
  .chan h3 { margin: 0 0 0.6rem; }
  .chan p { color: var(--fg-2); line-height: 1.65; margin: 0; }
  .footnote { color: var(--fg-3); font-size: 0.85rem; margin-top: 1.5rem; }

  /* The dashboard mock now lives in the <OperatorConsole> island (with its own
     scoped `.cm-*` styles) so the same markup renders whether it is showing live
     SSE telemetry or the offline sample data. */
</style>
