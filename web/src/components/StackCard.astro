---
interface Item {
  name: string;
  desc: string;
}
interface Props {
  title: string;
  items: Item[];
}
const { title, items } = Astro.props;
---

<div class="stack-card">
  <h4>{title}</h4>
  <ul>
    {items.map((it) => (
      <li>
        <span class="sc-name mono">{it.name}</span>
        <span class="sc-desc">{it.desc}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .stack-card {
    padding: 1.5rem;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 100%;
  }

  .stack-card h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-3);
    margin: 0 0 1rem;
    font-weight: 700;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  li:last-child { border-bottom: none; }

  .sc-name {
    display: block;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
    margin-bottom: 0.2rem;
  }

  .sc-desc {
    display: block;
    color: var(--fg-2);
    font-size: 0.82rem;
    line-height: 1.5;
  }
</style>
