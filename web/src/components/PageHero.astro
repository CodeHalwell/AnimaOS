---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-hero grid-bg">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {description && <p class="page-lede">{description}</p>}
  </div>
</header>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border-soft);
    background-image:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(125, 249, 200, 0.05), transparent 70%),
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: auto, 48px 48px, 48px 48px;
  }

  .page-hero h1 {
    margin: 1rem 0 1.25rem;
    max-width: 880px;
  }

  .page-lede {
    color: var(--fg-2);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 720px;
    margin: 0;
  }
</style>
