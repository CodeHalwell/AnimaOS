---
interface Props {
  n: string;
  name: string;
  desc: string;
  color: string;
}
const { n, name, desc, color } = Astro.props;
---

<article class="pill" style={`--c: ${color};`}>
  <div class="pill-head">
    <span class="pill-n mono">phase {n}</span>
    <span class="pill-dot" />
  </div>
  <h3>{name}</h3>
  <p>{desc}</p>
</article>

<style>
  .pill {
    padding: 1.5rem;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-top: 3px solid var(--c);
    border-radius: var(--radius);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .pill-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .pill-n {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--c);
    box-shadow: 0 0 10px 0 color-mix(in srgb, var(--c) 50%, transparent);
  }

  .pill h3 {
    margin: 0.5rem 0;
    color: var(--c);
  }

  .pill p {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.9rem;
    line-height: 1.6;
    flex-grow: 1;
  }
</style>
