---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-mlfq" class="diag-svg">
    <title id="dt-mlfq">Three-tier MLFQ scheduler: High, Medium, Low priority queues with boost-and-decay between tiers, feeding the iteration-aware continuous batching dispatch.</title>

    <defs>
      <marker id="mlfq-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#5dd1ff" />
      </marker>
      <marker id="mlfq-down" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#ffb454" />
      </marker>
    </defs>

    <!-- title -->
    <text x="40" y="40" font-family="ui-monospace, monospace" font-size="12" fill="#5dd1ff" font-weight="600">scheduler::IterationAwareMlfq</text>
    <text x="40" y="58" font-family="ui-monospace, monospace" font-size="10" fill="#5a6675">3 tiers · per-task token-slice tracking · boost-and-decay · iteration-level batching</text>

    <!-- High -->
    <g>
      <rect x="40" y="80" width="500" height="60" rx="6" fill="#0d1218" stroke="#7df9c8" stroke-opacity="0.6"/>
      <rect x="40" y="80" width="6" height="60" fill="#7df9c8"/>
      <text x="60" y="105" font-family="ui-monospace, monospace" font-size="13" font-weight="700" fill="#7df9c8">HIGH</text>
      <text x="60" y="122" font-family="ui-monospace, monospace" font-size="10" fill="#8590a0">tier.High · short token slice · preferred under stress</text>
      <!-- task pills -->
      <g>
        <rect x="220" y="93" width="60" height="34" rx="4" fill="#11161c" stroke="#7df9c8" stroke-opacity="0.4"/>
        <text x="250" y="114" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#03</text>
        <rect x="290" y="93" width="60" height="34" rx="4" fill="#11161c" stroke="#7df9c8" stroke-opacity="0.4"/>
        <text x="320" y="114" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#07</text>
        <rect x="360" y="93" width="60" height="34" rx="4" fill="#11161c" stroke="#7df9c8" stroke-opacity="0.4"/>
        <text x="390" y="114" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#11</text>
      </g>
    </g>

    <!-- Medium -->
    <g>
      <rect x="40" y="160" width="500" height="60" rx="6" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.6"/>
      <rect x="40" y="160" width="6" height="60" fill="#5dd1ff"/>
      <text x="60" y="185" font-family="ui-monospace, monospace" font-size="13" font-weight="700" fill="#5dd1ff">MEDIUM</text>
      <text x="60" y="202" font-family="ui-monospace, monospace" font-size="10" fill="#8590a0">tier.Medium · standard slice · default landing tier</text>
      <g>
        <rect x="220" y="173" width="60" height="34" rx="4" fill="#11161c" stroke="#5dd1ff" stroke-opacity="0.4"/>
        <text x="250" y="194" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#04</text>
        <rect x="290" y="173" width="60" height="34" rx="4" fill="#11161c" stroke="#5dd1ff" stroke-opacity="0.4"/>
        <text x="320" y="194" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#08</text>
      </g>
    </g>

    <!-- Low -->
    <g>
      <rect x="40" y="240" width="500" height="60" rx="6" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.6"/>
      <rect x="40" y="240" width="6" height="60" fill="#c084fc"/>
      <text x="60" y="265" font-family="ui-monospace, monospace" font-size="13" font-weight="700" fill="#c084fc">LOW</text>
      <text x="60" y="282" font-family="ui-monospace, monospace" font-size="10" fill="#8590a0">tier.Low · long slice · CPU-hungry batch work · starvation prevented by boost</text>
      <g>
        <rect x="220" y="253" width="60" height="34" rx="4" fill="#11161c" stroke="#c084fc" stroke-opacity="0.4"/>
        <text x="250" y="274" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#02</text>
        <rect x="290" y="253" width="60" height="34" rx="4" fill="#11161c" stroke="#c084fc" stroke-opacity="0.4"/>
        <text x="320" y="274" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#05</text>
        <rect x="360" y="253" width="60" height="34" rx="4" fill="#11161c" stroke="#c084fc" stroke-opacity="0.4"/>
        <text x="390" y="274" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#09</text>
        <rect x="430" y="253" width="60" height="34" rx="4" fill="#11161c" stroke="#c084fc" stroke-opacity="0.4"/>
        <text x="460" y="274" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#e6edf3">T#10</text>
      </g>
    </g>

    <!-- decay arrows between tiers -->
    <path d="M 470 130 Q 490 145 470 160" fill="none" stroke="#ffb454" stroke-width="1.5" marker-end="url(#mlfq-down)"/>
    <path d="M 470 210 Q 490 225 470 240" fill="none" stroke="#ffb454" stroke-width="1.5" marker-end="url(#mlfq-down)"/>
    <text x="500" y="148" font-family="ui-monospace, monospace" font-size="9" fill="#ffb454">decay on slice exhaustion</text>
    <text x="500" y="228" font-family="ui-monospace, monospace" font-size="9" fill="#ffb454">decay on slice exhaustion</text>

    <!-- boost arrow (low → high) -->
    <path d="M 520 270 Q 600 200 530 105" fill="none" stroke="#7df9c8" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#mlfq-arr)"/>
    <text x="610" y="195" font-family="ui-monospace, monospace" font-size="10" fill="#7df9c8" text-anchor="middle">periodic boost</text>
    <text x="610" y="210" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675" text-anchor="middle">prevents starvation</text>

    <!-- dispatch box -->
    <g>
      <rect x="680" y="120" width="160" height="140" rx="8" fill="#0d1218" stroke="#5dd1ff" stroke-width="2"/>
      <text x="760" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" font-weight="700" fill="#5dd1ff">dispatch_task</text>
      <text x="760" y="164" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#8590a0">iteration-aware</text>
      <text x="760" y="178" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#8590a0">continuous batching</text>
      <line x1="700" y1="192" x2="820" y2="192" stroke="#1f2a35"/>
      <text x="760" y="212" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#7df9c8">→ BoundedTokenPipe</text>
      <text x="760" y="226" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#5dd1ff">→ LlmBackend</text>
      <text x="760" y="240" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#c084fc">→ CancellationToken</text>
    </g>

    <!-- dispatch in arrows -->
    <line x1="540" y1="110" x2="680" y2="150" stroke="#7df9c8" stroke-width="1.5" stroke-opacity="0.6" marker-end="url(#mlfq-arr)"/>
    <line x1="540" y1="190" x2="680" y2="190" stroke="#5dd1ff" stroke-width="1.5" stroke-opacity="0.6" marker-end="url(#mlfq-arr)"/>
    <line x1="540" y1="270" x2="680" y2="230" stroke="#c084fc" stroke-width="1.5" stroke-opacity="0.6" marker-end="url(#mlfq-arr)"/>

    <!-- bottom annotation -->
    <text x="40" y="340" font-family="ui-monospace, monospace" font-size="10" fill="#5a6675">select_optimal_task(stress) reaches into the highest non-empty tier whose tasks fit the current envelope.</text>
  </svg>
  {caption && <figcaption>Three priority levels with token-slice tracking. Tasks decay to lower tiers when their slice is exhausted; periodic boost prevents starvation. Iteration-aware dispatch feeds the bounded token pipe.</figcaption>}
</figure>
