---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-cog" class="diag-svg">
    <title id="dt-cog">Cognitive layer above the somatic substrate: reflex policies, gated working memory, deliberative cortex; modulated by body state from animad.</title>

    <defs>
      <marker id="cg-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#5dd1ff" />
      </marker>
      <marker id="cg-mod" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#ffb454" />
      </marker>
    </defs>

    <!-- Body daemon (bottom) -->
    <rect x="40" y="370" width="800" height="70" rx="10" fill="#0c1014" stroke="#7df9c8" stroke-opacity="0.4"/>
    <text x="60" y="395" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">animad · body daemon (Rust)</text>
    <text x="60" y="413" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">sensorium · motor · homeostatic signals · survives the cortex crashing</text>
    <text x="60" y="430" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">thermal · CPU/GPU · memory · power · network · filesystem · presence · finance</text>

    <!-- Reflex policies (low-left) -->
    <rect x="40" y="250" width="240" height="100" rx="10" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
    <text x="60" y="275" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">reflex policies</text>
    <text x="60" y="293" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">fast · cheap · always-on</text>
    <text x="60" y="310" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">handle the majority of events</text>
    <text x="60" y="326" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">without invoking the cortex</text>
    <text x="60" y="342" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">→ trip the gate to escalate</text>

    <!-- Striatal gate (middle) -->
    <rect x="300" y="250" width="280" height="100" rx="10" fill="#0d1218" stroke="#7df9c8" stroke-width="2"/>
    <text x="320" y="275" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">gated working memory</text>
    <text x="320" y="293" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">striatal gate · learned escalation policy</text>
    <text x="320" y="310" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">selects, suppresses, or combines</text>
    <text x="320" y="326" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">structured proposals from subsystems</text>
    <text x="320" y="342" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">no chat · proposals only</text>

    <!-- Cortex (right) -->
    <rect x="600" y="250" width="240" height="100" rx="10" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.55"/>
    <text x="620" y="275" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">cortex (LLM)</text>
    <text x="620" y="293" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">slow · expensive · deliberative</text>
    <text x="620" y="310" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">invoked only when fast policies</text>
    <text x="620" y="326" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">cannot resolve the situation</text>
    <text x="620" y="342" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">local model · API · or refused</text>

    <!-- Learned KV controller (top) -->
    <rect x="180" y="120" width="520" height="80" rx="10" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.55"/>
    <text x="200" y="148" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">kv-controller · learned KV-cache controller</text>
    <text x="200" y="166" font-family="ui-monospace, monospace" font-size="10" fill="#b8c2cc">decides what the system remembers, compresses, and forgets across long-horizon operation</text>
    <text x="200" y="184" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">selective forgetting · the technical core of long-context retention</text>

    <!-- Episode / identity memory (top right) -->
    <rect x="720" y="120" width="120" height="80" rx="10" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.55"/>
    <text x="780" y="146" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" font-weight="700" fill="#c084fc">identity memory</text>
    <text x="780" y="164" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">across installs</text>
    <text x="780" y="182" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">backed by L3</text>

    <!-- Defence layer above -->
    <rect x="40" y="40" width="800" height="60" rx="10" fill="#0d1218" stroke="#ff6b6b" stroke-opacity="0.5"/>
    <text x="60" y="62" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#ff6b6b">defence layer</text>
    <text x="60" y="80" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">pre-cortex input filter · post-cortex output gate · quarantine · rate-limit</text>

    <!-- arrows: body → reflex / gate / cortex (sensorium upward) -->
    <line x1="160" y1="370" x2="160" y2="350" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#cg-arr)"/>
    <line x1="440" y1="370" x2="440" y2="350" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#cg-arr)"/>
    <line x1="720" y1="370" x2="720" y2="350" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#cg-arr)"/>

    <!-- modulation arrows (body state modulates thresholds) -->
    <path d="M 60 380 Q 20 200 200 130" fill="none" stroke="#ffb454" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#cg-mod)"/>
    <text x="60" y="240" font-family="ui-monospace, monospace" font-size="8" fill="#ffb454" transform="rotate(-90 60 240)">body state modulates thresholds</text>

    <!-- reflex → gate -->
    <line x1="280" y1="300" x2="300" y2="300" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#cg-arr)"/>
    <!-- gate → cortex -->
    <line x1="580" y1="300" x2="600" y2="300" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#cg-arr)"/>
    <!-- gate → kv-controller -->
    <line x1="440" y1="250" x2="440" y2="200" stroke="#5dd1ff" stroke-width="1.5" stroke-opacity="0.6" marker-end="url(#cg-arr)"/>
    <!-- cortex → defence → outbound -->
    <line x1="720" y1="250" x2="720" y2="100" stroke="#c084fc" stroke-width="1.5" stroke-opacity="0.6" marker-end="url(#cg-arr)"/>
  </svg>
  {caption && <figcaption>Reflex policies handle most events; the striatal gate routes the residual to the deliberative cortex; the kv-controller maintains long-context coherence. Body state from <code>animad</code> continuously modulates escalation thresholds.</figcaption>}
</figure>
