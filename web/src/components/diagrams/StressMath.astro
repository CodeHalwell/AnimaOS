---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-stress" class="diag-svg">
    <title id="dt-stress">Stress index composition: latency ratio (TTFT / baseline) and context saturation (active tokens / max) combined via β-weighted sum, with four threshold bands.</title>

    <defs>
      <linearGradient id="band-grad" x1="0" x2="1">
        <stop offset="0%" stop-color="#7df9c8"/>
        <stop offset="40%" stop-color="#5dd1ff"/>
        <stop offset="75%" stop-color="#ffb454"/>
        <stop offset="100%" stop-color="#ff6b6b"/>
      </linearGradient>
    </defs>

    <!-- inputs -->
    <g>
      <rect x="40" y="60" width="240" height="80" rx="8" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
      <text x="160" y="85" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">latency input</text>
      <text x="160" y="103" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="#e6edf3">TTFT / TTFT_baseline − 1</text>
      <text x="160" y="122" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">rolling window in interoception</text>
    </g>

    <g>
      <rect x="40" y="180" width="240" height="80" rx="8" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.5"/>
      <text x="160" y="205" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">memory input</text>
      <text x="160" y="223" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="#e6edf3">active_tokens / max_tokens</text>
      <text x="160" y="242" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">exact L1 occupancy</text>
    </g>

    <!-- combine -->
    <g>
      <rect x="340" y="120" width="200" height="100" rx="8" fill="#0d1218" stroke="#7df9c8" stroke-width="2"/>
      <text x="440" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">composite</text>
      <text x="440" y="170" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="#e6edf3">s = clamp(0, 1,</text>
      <text x="440" y="187" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="#5dd1ff">β · L + (1−β) · M )</text>
      <text x="440" y="206" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">β = 0.5 default</text>
    </g>

    <line x1="280" y1="100" x2="340" y2="150" stroke="#5dd1ff" stroke-width="1.5"/>
    <line x1="280" y1="220" x2="340" y2="180" stroke="#c084fc" stroke-width="1.5"/>

    <!-- stress bar -->
    <g>
      <rect x="600" y="120" width="240" height="100" rx="8" fill="#0d1218" stroke="#1f2a35"/>
      <text x="720" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">stress index s ∈ [0,1]</text>
      <rect x="616" y="170" width="208" height="14" rx="3" fill="#11161c" stroke="#1f2a35"/>
      <rect x="616" y="170" width="208" height="14" rx="3" fill="url(#band-grad)" opacity="0.55"/>
      <line x1="616" y1="186" x2="616" y2="200" stroke="#5a6675"/>
      <line x1="699" y1="186" x2="699" y2="200" stroke="#5a6675"/>
      <line x1="772" y1="186" x2="772" y2="200" stroke="#5a6675"/>
      <line x1="824" y1="186" x2="824" y2="200" stroke="#5a6675"/>
      <text x="616" y="212" font-family="ui-monospace, monospace" font-size="8" fill="#5a6675">0.0</text>
      <text x="699" y="212" text-anchor="middle" font-family="ui-monospace, monospace" font-size="8" fill="#7df9c8">0.40</text>
      <text x="772" y="212" text-anchor="middle" font-family="ui-monospace, monospace" font-size="8" fill="#ffb454">0.75</text>
      <text x="824" y="212" text-anchor="end" font-family="ui-monospace, monospace" font-size="8" fill="#ff6b6b">0.90</text>
    </g>

    <line x1="540" y1="170" x2="600" y2="170" stroke="#7df9c8" stroke-width="1.5"/>

    <!-- threshold actions -->
    <g font-family="ui-monospace, monospace" font-size="10">
      <rect x="40" y="290" width="200" height="80" rx="6" fill="#0d1218" stroke="#7df9c8" stroke-opacity="0.5"/>
      <text x="55" y="310" font-weight="700" fill="#7df9c8">s &lt; 0.40</text>
      <text x="55" y="328" fill="#b8c2cc">if agenda empty:</text>
      <text x="55" y="344" fill="#7df9c8">transition_to_sleep()</text>

      <rect x="252" y="290" width="200" height="80" rx="6" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
      <text x="267" y="310" font-weight="700" fill="#5dd1ff">0.40 – 0.75</text>
      <text x="267" y="328" fill="#b8c2cc">normal loop:</text>
      <text x="267" y="344" fill="#5dd1ff">select_optimal_task(s)</text>

      <rect x="464" y="290" width="200" height="80" rx="6" fill="#0d1218" stroke="#ffb454" stroke-opacity="0.5"/>
      <text x="479" y="310" font-weight="700" fill="#ffb454">0.75 – 0.90</text>
      <text x="479" y="328" fill="#b8c2cc">pressure response:</text>
      <text x="479" y="344" fill="#ffb454">L1 → L2 demotion</text>

      <rect x="676" y="290" width="164" height="80" rx="6" fill="#0d1218" stroke="#ff6b6b" stroke-opacity="0.5"/>
      <text x="691" y="310" font-weight="700" fill="#ff6b6b">s ≥ 0.90</text>
      <text x="691" y="328" fill="#b8c2cc">critical:</text>
      <text x="691" y="344" fill="#ff6b6b">emergency_consolidate()</text>
    </g>
  </svg>
  {caption && <figcaption>One scalar drives the whole lifecycle. Two inputs — latency degradation and context saturation — are combined into a single β-weighted stress index, with four thresholded actions.</figcaption>}
</figure>
