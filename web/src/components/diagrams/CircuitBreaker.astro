---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-cb" class="diag-svg">
    <title id="dt-cb">Circuit breaker state machine for each tool driver: Closed (passing) → Open (failing fast) → HalfOpen (probing) and back.</title>

    <defs>
      <marker id="cb-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#5a6675" />
      </marker>
    </defs>

    <!-- Closed -->
    <g>
      <circle cx="160" cy="160" r="80" fill="#0d1218" stroke="#7df9c8" stroke-width="2"/>
      <text x="160" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="14" font-weight="700" fill="#7df9c8">CLOSED</text>
      <text x="160" y="168" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="#b8c2cc">requests pass</text>
      <text x="160" y="184" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">failures counted</text>
    </g>

    <!-- Open -->
    <g>
      <circle cx="440" cy="160" r="80" fill="#0d1218" stroke="#ff6b6b" stroke-width="2"/>
      <text x="440" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="14" font-weight="700" fill="#ff6b6b">OPEN</text>
      <text x="440" y="168" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="#b8c2cc">fail fast</text>
      <text x="440" y="184" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">cooldown timer</text>
    </g>

    <!-- HalfOpen -->
    <g>
      <circle cx="720" cy="160" r="80" fill="#0d1218" stroke="#ffb454" stroke-width="2"/>
      <text x="720" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="14" font-weight="700" fill="#ffb454">HALF-OPEN</text>
      <text x="720" y="168" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="#b8c2cc">single probe</text>
      <text x="720" y="184" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">one request only</text>
    </g>

    <!-- Closed → Open -->
    <path d="M 240 145 Q 340 100 360 145" fill="none" stroke="#ff6b6b" stroke-width="1.5" marker-end="url(#cb-arr)"/>
    <text x="300" y="105" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#ff6b6b">failure_threshold exceeded</text>

    <!-- Open → HalfOpen -->
    <path d="M 520 145 Q 620 100 640 145" fill="none" stroke="#ffb454" stroke-width="1.5" marker-end="url(#cb-arr)"/>
    <text x="580" y="105" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#ffb454">cooldown elapsed</text>

    <!-- HalfOpen → Closed (success) -->
    <path d="M 660 200 Q 440 280 240 200" fill="none" stroke="#7df9c8" stroke-width="1.5" marker-end="url(#cb-arr)"/>
    <text x="440" y="270" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#7df9c8">probe succeeded · reset counters</text>

    <!-- HalfOpen → Open (failure) -->
    <path d="M 720 240 Q 720 280 600 260 Q 500 240 500 220" fill="none" stroke="#ff6b6b" stroke-width="1.5" marker-end="url(#cb-arr)"/>
    <text x="660" y="285" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#ff6b6b">probe failed</text>

    <!-- legend -->
    <g font-family="ui-monospace, monospace" font-size="10" fill="#5a6675">
      <text x="40" y="40">crates/praxis/src/breaker.rs</text>
      <text x="40" y="300">one breaker per tool · state visible on /dev/anima/interoception/telemetry</text>
    </g>
  </svg>
  {caption && <figcaption>Every tool driver is wrapped in a state monitor that observes failure rates. The breaker isolates a misbehaving tool from the system core without requiring intervention.</figcaption>}
</figure>
