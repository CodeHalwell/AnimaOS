---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-planes" class="diag-svg">
    <title id="dt-planes">AnimaOS planes: hardware, autonomic substrate (corpus), somatic layer (agent at PID 1), and human-as-peripheral input.</title>

    <defs>
      <linearGradient id="lg-fg" x1="0" x2="1">
        <stop offset="0%" stop-color="#7df9c8"/>
        <stop offset="100%" stop-color="#5dd1ff"/>
      </linearGradient>
      <linearGradient id="lg-cog" x1="0" x2="1">
        <stop offset="0%" stop-color="#5dd1ff"/>
        <stop offset="100%" stop-color="#c084fc"/>
      </linearGradient>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#5a6675" />
      </marker>
      <marker id="arr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#7df9c8" />
      </marker>
    </defs>

    <!-- Hardware plane -->
    <rect x="60" y="430" width="760" height="60" rx="8" fill="#0c1014" stroke="#1f2a35" />
    <text x="80" y="465" font-family="ui-monospace, monospace" font-size="12" fill="#5a6675">HARDWARE</text>
    <text x="80" y="482" font-family="ui-monospace, monospace" font-size="10" fill="#3a4452">x86_64 / aarch64 · UEFI · virtio · NIC · accelerator</text>

    <!-- TCB plane -->
    <rect x="60" y="320" width="760" height="90" rx="8" fill="#11161c" stroke="#ff6b6b" stroke-opacity="0.4" />
    <text x="80" y="345" font-family="ui-monospace, monospace" font-size="12" fill="#ff6b6b" font-weight="600">AUTONOMIC SUBSTRATE · corpus (TCB)</text>
    <text x="80" y="362" font-family="ui-monospace, monospace" font-size="10" fill="#5a6675">audited unsafe · frame allocator · page tables · boot trampoline · syscall enum</text>

    <g font-family="ui-monospace, monospace" font-size="10" fill="#b8c2cc">
      <rect x="80" y="375" width="130" height="22" rx="4" fill="#182028" stroke="#1f2a35"/>
      <text x="145" y="390" text-anchor="middle">FrameAllocator</text>
      <rect x="225" y="375" width="130" height="22" rx="4" fill="#182028" stroke="#1f2a35"/>
      <text x="290" y="390" text-anchor="middle">AgentPCB</text>
      <rect x="370" y="375" width="130" height="22" rx="4" fill="#182028" stroke="#1f2a35"/>
      <text x="435" y="390" text-anchor="middle">SyscallEnum</text>
      <rect x="515" y="375" width="130" height="22" rx="4" fill="#182028" stroke="#1f2a35"/>
      <text x="580" y="390" text-anchor="middle">ContextSwitch</text>
      <rect x="660" y="375" width="140" height="22" rx="4" fill="#182028" stroke="#1f2a35"/>
      <text x="730" y="390" text-anchor="middle">embassy executor</text>
    </g>

    <!-- Somatic layer -->
    <rect x="60" y="100" width="760" height="200" rx="8" fill="#0d1218" stroke="#7df9c8" stroke-opacity="0.35"/>
    <text x="80" y="125" font-family="ui-monospace, monospace" font-size="12" fill="#7df9c8" font-weight="600">SOMATIC LAYER · agent runs as PID 1 (init)</text>
    <text x="80" y="142" font-family="ui-monospace, monospace" font-size="10" fill="#5a6675">#![forbid(unsafe_code)] · supervises itself · sequences its own execution loops</text>

    <!-- subsystem boxes -->
    <g font-family="ui-monospace, monospace" font-size="11">
      <!-- senses -->
      <rect x="80" y="160" width="140" height="120" rx="6" fill="#182028" stroke="#c084fc" stroke-opacity="0.45"/>
      <text x="150" y="180" text-anchor="middle" fill="#c084fc" font-weight="600">senses</text>
      <text x="150" y="197" text-anchor="middle" fill="#8590a0" font-size="9">afferent input</text>
      <line x1="95" y1="208" x2="205" y2="208" stroke="#1f2a35"/>
      <text x="150" y="223" text-anchor="middle" fill="#b8c2cc" font-size="9">text · voice (PCM)</text>
      <text x="150" y="237" text-anchor="middle" fill="#b8c2cc" font-size="9">RPC · peers (A2A)</text>
      <text x="150" y="261" text-anchor="middle" fill="#5a6675" font-size="8">/dev/anima/senses/</text>

      <!-- vita -->
      <rect x="240" y="160" width="140" height="120" rx="6" fill="#182028" stroke="#7df9c8" stroke-opacity="0.55"/>
      <text x="310" y="180" text-anchor="middle" fill="#7df9c8" font-weight="600">vita</text>
      <text x="310" y="197" text-anchor="middle" fill="#8590a0" font-size="9">lifecycle director</text>
      <line x1="255" y1="208" x2="365" y2="208" stroke="#1f2a35"/>
      <text x="310" y="223" text-anchor="middle" fill="#b8c2cc" font-size="9">somatic_execution_loop</text>
      <text x="310" y="237" text-anchor="middle" fill="#b8c2cc" font-size="9">sleep transitions</text>
      <text x="310" y="261" text-anchor="middle" fill="#5a6675" font-size="8">/dev/anima/vital</text>

      <!-- scheduler -->
      <rect x="400" y="160" width="140" height="120" rx="6" fill="#182028" stroke="#5dd1ff" stroke-opacity="0.55"/>
      <text x="470" y="180" text-anchor="middle" fill="#5dd1ff" font-weight="600">scheduler</text>
      <text x="470" y="197" text-anchor="middle" fill="#8590a0" font-size="9">3-tier MLFQ</text>
      <line x1="415" y1="208" x2="525" y2="208" stroke="#1f2a35"/>
      <text x="470" y="223" text-anchor="middle" fill="#b8c2cc" font-size="9">dispatch_task</text>
      <text x="470" y="237" text-anchor="middle" fill="#b8c2cc" font-size="9">BoundedTokenPipe</text>
      <text x="470" y="261" text-anchor="middle" fill="#5a6675" font-size="8">credit backpressure</text>

      <!-- memory -->
      <rect x="560" y="160" width="120" height="120" rx="6" fill="#182028" stroke="#c084fc" stroke-opacity="0.55"/>
      <text x="620" y="180" text-anchor="middle" fill="#c084fc" font-weight="600">memory</text>
      <text x="620" y="197" text-anchor="middle" fill="#8590a0" font-size="9">CLS hierarchy</text>
      <line x1="575" y1="208" x2="665" y2="208" stroke="#1f2a35"/>
      <text x="620" y="225" text-anchor="middle" fill="#7df9c8" font-size="10" font-weight="600">L1 → L2 → L3</text>
      <text x="620" y="245" text-anchor="middle" fill="#b8c2cc" font-size="9">emotional decay</text>
      <text x="620" y="262" text-anchor="middle" fill="#5a6675" font-size="8">LanceDB</text>

      <!-- praxis -->
      <rect x="700" y="160" width="100" height="120" rx="6" fill="#182028" stroke="#ffb454" stroke-opacity="0.55"/>
      <text x="750" y="180" text-anchor="middle" fill="#ffb454" font-weight="600">praxis</text>
      <text x="750" y="197" text-anchor="middle" fill="#8590a0" font-size="9">efferent</text>
      <line x1="715" y1="208" x2="785" y2="208" stroke="#1f2a35"/>
      <text x="750" y="223" text-anchor="middle" fill="#b8c2cc" font-size="9">routing</text>
      <text x="750" y="237" text-anchor="middle" fill="#b8c2cc" font-size="9">breakers</text>
      <text x="750" y="261" text-anchor="middle" fill="#5a6675" font-size="8">wasmtime</text>
    </g>

    <!-- Human peripheral -->
    <g>
      <rect x="60" y="20" width="220" height="60" rx="8" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.5"/>
      <circle cx="92" cy="50" r="14" fill="#11161c" stroke="#c084fc"/>
      <text x="92" y="54" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="#c084fc">👤</text>
      <text x="120" y="48" font-family="ui-monospace, monospace" font-size="11" fill="#c084fc" font-weight="600">HUMAN OPERATOR</text>
      <text x="120" y="64" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">peripheral input · not the controller</text>
    </g>

    <!-- Body schematic -->
    <g>
      <rect x="600" y="20" width="220" height="60" rx="8" fill="#0d1218" stroke="#1f2a35"/>
      <text x="710" y="42" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="#7df9c8" font-weight="600">/dev/anima/ namespace</text>
      <text x="710" y="58" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">senses · vital · memory · praxis</text>
      <text x="710" y="72" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">no /proc, no /sys, no display server</text>
    </g>

    <!-- arrows -->
    <line x1="150" y1="80" x2="150" y2="160" stroke="#7df9c8" stroke-width="1.5" marker-end="url(#arr-a)"/>
    <line x1="710" y1="80" x2="620" y2="160" stroke="#5a6675" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#arr)"/>
    <line x1="440" y1="320" x2="440" y2="300" stroke="#5a6675" stroke-width="1" marker-end="url(#arr)"/>
    <line x1="440" y1="430" x2="440" y2="410" stroke="#5a6675" stroke-width="1" marker-end="url(#arr)"/>
  </svg>
  {caption && <figcaption>The agent runs at PID 1. Its model of its own body is <code>/dev/anima/</code>. The human is mounted as one input among others — the kernel cannot be preempted by typing.</figcaption>}
</figure>
