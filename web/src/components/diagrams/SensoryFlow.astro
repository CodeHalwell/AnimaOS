---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-sense" class="diag-svg">
    <title id="dt-sense">Afferent sensory flow: text, voice (PCM), and peer (A2A) streams parsed into SensoryPacket envelopes, prioritised, then handed to vita.</title>

    <defs>
      <marker id="sn-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#c084fc" />
      </marker>
    </defs>

    <!-- raw input sources -->
    <g>
      <rect x="40" y="60" width="180" height="50" rx="6" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.5"/>
      <text x="130" y="82" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">⌨ text buffer</text>
      <text x="130" y="98" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">UTF-8 · Unix socket</text>

      <rect x="40" y="155" width="180" height="50" rx="6" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.5"/>
      <text x="130" y="177" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">🎙 PCM voice</text>
      <text x="130" y="193" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">16-bit @ 16 kHz</text>

      <rect x="40" y="250" width="180" height="50" rx="6" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.5"/>
      <text x="130" y="272" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">⇄ A2A peer</text>
      <text x="130" y="288" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">peer-agent RPC</text>
    </g>

    <!-- parsers -->
    <g>
      <rect x="280" y="60" width="180" height="50" rx="6" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
      <text x="370" y="82" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">text parser</text>
      <text x="370" y="98" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">tokenise · timestamp</text>

      <rect x="280" y="155" width="180" height="50" rx="6" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
      <text x="370" y="177" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">VAD + STT</text>
      <text x="370" y="193" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">voice activity · speech-to-text</text>

      <rect x="280" y="250" width="180" height="50" rx="6" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.5"/>
      <text x="370" y="272" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">A2A decoder</text>
      <text x="370" y="288" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">postcard envelope</text>
    </g>

    <!-- packet envelope -->
    <g>
      <rect x="520" y="120" width="200" height="120" rx="8" fill="#0d1218" stroke="#7df9c8" stroke-width="2"/>
      <text x="620" y="146" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">SensoryPacket</text>
      <line x1="535" y1="156" x2="705" y2="156" stroke="#1f2a35"/>
      <text x="535" y="174" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">source: Source</text>
      <text x="535" y="190" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">timestamp: u64</text>
      <text x="535" y="206" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">priority: Priority</text>
      <text x="535" y="222" font-family="ui-monospace, monospace" font-size="9" fill="#b8c2cc">payload: Bytes</text>
    </g>

    <!-- to vita -->
    <g>
      <rect x="760" y="150" width="80" height="60" rx="8" fill="#0d1218" stroke="#7df9c8"/>
      <text x="800" y="180" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">vita</text>
      <text x="800" y="195" text-anchor="middle" font-family="ui-monospace, monospace" font-size="8" fill="#5a6675">consumer</text>
    </g>

    <!-- arrows -->
    <line x1="220" y1="85" x2="280" y2="85" stroke="#c084fc" stroke-width="1.5" marker-end="url(#sn-arr)"/>
    <line x1="220" y1="180" x2="280" y2="180" stroke="#c084fc" stroke-width="1.5" marker-end="url(#sn-arr)"/>
    <line x1="220" y1="275" x2="280" y2="275" stroke="#c084fc" stroke-width="1.5" marker-end="url(#sn-arr)"/>

    <line x1="460" y1="85" x2="520" y2="160" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#sn-arr)"/>
    <line x1="460" y1="180" x2="520" y2="180" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#sn-arr)"/>
    <line x1="460" y1="275" x2="520" y2="200" stroke="#5dd1ff" stroke-width="1.5" marker-end="url(#sn-arr)"/>

    <line x1="720" y1="180" x2="760" y2="180" stroke="#7df9c8" stroke-width="1.5" marker-end="url(#sn-arr)"/>

    <text x="40" y="40" font-family="ui-monospace, monospace" font-size="11" fill="#c084fc" font-weight="600">/dev/anima/senses/</text>
    <text x="40" y="340" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">priority is driver-level · voice defaults high · peers default medium · text defaults guidance-derived</text>
  </svg>
  {caption && <figcaption>Every input is wrapped in a common envelope before reaching policy code. The agent treats voice, text, and peer messages as the same kind of thing: a prioritised sensory event with a known source.</figcaption>}
</figure>
