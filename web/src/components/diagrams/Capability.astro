---
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure class="diag">
  <svg viewBox="0 0 880 340" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dt-cap" class="diag-svg">
    <title id="dt-cap">Typestate capability barrier: a Capability&lt;Unverified&gt; must transition through verify() to Capability&lt;Verified&gt; before it can authorise a syscall. Compile-time check.</title>

    <defs>
      <marker id="cap-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#7df9c8" />
      </marker>
      <marker id="cap-err" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="#ff6b6b" />
      </marker>
    </defs>

    <text x="40" y="40" font-family="ui-monospace, monospace" font-size="12" fill="#5dd1ff" font-weight="600">crates/self · anima-self::cap</text>

    <!-- Role plate -->
    <g>
      <rect x="40" y="70" width="180" height="80" rx="8" fill="#0d1218" stroke="#c084fc" stroke-opacity="0.55"/>
      <text x="130" y="96" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#c084fc">Role</text>
      <text x="130" y="116" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#b8c2cc">e.g. consolidator</text>
      <text x="130" y="132" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">fixed at build time</text>
    </g>

    <!-- Unverified -->
    <g>
      <rect x="260" y="70" width="200" height="80" rx="8" fill="#0d1218" stroke="#ffb454" stroke-opacity="0.55"/>
      <text x="360" y="96" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#ffb454">Capability&lt;Unverified&gt;</text>
      <text x="360" y="116" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#b8c2cc">just data · no authority</text>
      <text x="360" y="132" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">cannot call syscall()</text>
    </g>

    <!-- verify() arrow -->
    <line x1="460" y1="110" x2="540" y2="110" stroke="#7df9c8" stroke-width="2" marker-end="url(#cap-arr)"/>
    <text x="500" y="100" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#7df9c8">.verify(&amp;role)</text>
    <text x="500" y="124" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">consumes self</text>

    <!-- Verified -->
    <g>
      <rect x="540" y="70" width="200" height="80" rx="8" fill="#0d1218" stroke="#7df9c8" stroke-width="2"/>
      <text x="640" y="96" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#7df9c8">Capability&lt;Verified&gt;</text>
      <text x="640" y="116" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#b8c2cc">authorises syscall</text>
      <text x="640" y="132" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">single-use by move</text>
    </g>

    <!-- syscall arrow -->
    <line x1="640" y1="150" x2="640" y2="190" stroke="#7df9c8" stroke-width="2" marker-end="url(#cap-arr)"/>

    <!-- syscall handler -->
    <g>
      <rect x="540" y="200" width="200" height="60" rx="8" fill="#0d1218" stroke="#5dd1ff" stroke-opacity="0.6"/>
      <text x="640" y="225" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill="#5dd1ff">corpus::syscall(cap, op)</text>
      <text x="640" y="244" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">TCB · audited unsafe permitted</text>
    </g>

    <!-- compile error path -->
    <line x1="360" y1="150" x2="360" y2="200" stroke="#ff6b6b" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#cap-err)"/>
    <g>
      <rect x="260" y="210" width="200" height="60" rx="8" fill="#0d1218" stroke="#ff6b6b" stroke-opacity="0.5"/>
      <text x="360" y="232" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" font-weight="700" fill="#ff6b6b">does not compile</text>
      <text x="360" y="251" text-anchor="middle" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">type mismatch at the call site</text>
    </g>

    <!-- annotations -->
    <text x="40" y="190" font-family="ui-monospace, monospace" font-size="9" fill="#5a6675">issuance</text>
    <line x1="220" y1="110" x2="260" y2="110" stroke="#c084fc" stroke-width="1.5" marker-end="url(#cap-arr)"/>

    <!-- Elevation -->
    <g>
      <rect x="40" y="280" width="800" height="44" rx="6" fill="#0d1218" stroke="#1f2a35"/>
      <text x="60" y="300" font-family="ui-monospace, monospace" font-size="10" fill="#c084fc">ElevationToken</text>
      <text x="60" y="316" font-family="ui-monospace, monospace" font-size="9" fill="#8590a0">single-use value that upgrades a restricted capability to an unrestricted one for exactly one call · consumed on use</text>
    </g>
  </svg>
  {caption && <figcaption>The type system enforces the call ordering at compile time. A function expecting <code>Capability&lt;Verified&gt;</code> cannot be called with <code>Capability&lt;Unverified&gt;</code> — permission violations become un-compilable.</figcaption>}
</figure>
