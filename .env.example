# AnimaOS — docker-compose environment template.
# Copy to `.env` and adjust; every variable has a working default, so an
# empty `.env` (or none at all) is also fine.

# ── Backend selection ───────────────────────────────────────────────────
# ollama (default) | mock | anthropic | openai
ANIMA_BACKEND=ollama

# ── Ollama stack (docker-compose.yml / docker-compose.cpu.yml) ──────────
# Pinned Ollama image tag; bump deliberately.
OLLAMA_VERSION=0.30.0
# Models pulled by ollama-init.  GPU defaults shown; the CPU overlay
# substitutes smaller models (see docker-compose.cpu.yml).
#ANIMA_INSTINCT_MODEL=hf.co/unsloth/gemma-4-E2B-it-GGUF:Q4_K_M
#ANIMA_WORKHORSE_MODEL=hf.co/unsloth/Qwen3.5-9B-MTP-GGUF:Q4_K_M
# Model the agent requests (defaults to the workhorse above).
#ANIMA_OLLAMA_MODEL=
# Context window; the CPU overlay lowers this to 4096.
#ANIMA_OLLAMA_CTX=8192

# ── Hosted API providers (optional) ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Operator console ────────────────────────────────────────────────────
# Set to require a bearer token on /events and /guidance (recommended for
# anything beyond localhost experimentation).  Pass it to the dashboard as
# http://127.0.0.1:8088/?token=<value> and to anima-console via --token.
# REQUIRED whenever ANIMA_CONSOLE_ADDR binds a non-loopback address (e.g.
# 0.0.0.0): the console refuses to start unauthenticated off loopback.
ANIMA_CONSOLE_TOKEN=
# Bind address for the console. Defaults to 127.0.0.1:8088 (loopback only).
# Override to e.g. 0.0.0.0:8088 to expose it — but only with a token set above,
# and ideally behind a TLS-terminating reverse proxy.
# ANIMA_CONSOLE_ADDR=127.0.0.1:8088

# ── Sleep-phase training corpus ─────────────────────────────────────────
# Where the agent persists compiled training pairs (PolicyCompilation, E3.8).
# Defaults to ~/.anima/training_corpus inside the anima-data volume, which
# the trainer reads at /anima-data/training_corpus.  Set to `off` to disable
# corpus persistence entirely.
#ANIMA_CORPUS_DIR=

# ── Sleep-phase trainer (profile: training) ─────────────────────────────
#TRAINER_BASE_MODEL=unsloth/gemma-4-E2B-it-unsloth-bnb-4bit
